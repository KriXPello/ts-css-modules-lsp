{
  "name": "ts-css-modules-lsp",
  "version": "0.1.1",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "config.example.json"
  ],
  "description": "A vtsls proxy with CSS Modules source definitions over LSP",
  "bin": {
    "ts-css-modules-lsp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js --stdio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vtsls/language-server": "0.3.0",
    "icss-utils": "5.1.0",
    "lodash.camelcase": "4.3.0",
    "postcss": "8.5.31",
    "postcss-modules-extract-imports": "3.1.0",
    "postcss-modules-local-by-default": "4.2.0",
    "postcss-modules-scope": "3.2.1",
    "postcss-scss": "4.0.9",
    "postcss-selector-parser": "7.1.6",
    "sass": "1.105.2",
    "source-map-js": "1.2.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.18.4",
    "vscode-languageserver-textdocument": "1.0.15",
    "vscode-uri": "3.2.0"
  },
  "devDependencies": {
    "@types/icss-utils": "5.1.2",
    "@types/lodash.camelcase": "4.3.9",
    "@types/node": "22.20.5",
    "@types/postcss-modules-extract-imports": "3.0.5",
    "@types/postcss-modules-local-by-default": "4.0.2",
    "@types/postcss-modules-scope": "3.0.4"
  }
}
